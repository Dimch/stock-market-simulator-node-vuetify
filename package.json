{
  "name": "stock-market-simulator-fullstack",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "description": "Stock Market Simulator - Turborepo Monorepo",
  "packageManager": "npm@11.7.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:smoke:frontend": "npm --workspace packages/frontend run test:smoke",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "eslint": "9.39.3",
    "husky": "9.1.7",
    "turbo": "2.9.6"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
