{
  "name": "stock-market-simulator-fullstack",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "scripts": {
    "dev": "nodemon ./backend/server.js localhost 3001",
    "dev:vite": "vite",
    "docker:build": "docker build -t stock-market-simulator .",
    "docker:run": "docker run -p 3000:3000 -d --rm --name stock-market-simulator-app stock-market-simulator",
    "docker:run-dev": "docker run -p 3000:3000 -d --rm -v $(pwd)/backend:/app/backend -v $(pwd)/src:/app/src -v $(pwd)/public:/app/public --name stock-market-simulator-app stock-market-simulator",
    "docker:stop": "docker stop stock-market-simulator-app",
    "docker": "npm run docker:build && npm run docker:run",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "prepare": "node .husky/install.js"
  },
