    "express-static-gzip": "3.0.0",
    "helmet": "8.1.0",
    "lodash": "4.18.1",
    "luxon": "3.7.2",
    "passport": "0.7.0",
    "passport-local": "1.0.0",
    "pg": "8.20.0",
